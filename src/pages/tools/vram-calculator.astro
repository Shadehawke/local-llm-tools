---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { MODEL_ARCHITECTURES } from "../../data/models";
import { QUANT_FORMATS } from "../../data/quants";
import { KV_QUANT_PRESETS } from "../../lib/vramCalculator";
import type { TurboQuantEstimate } from "../../lib/vramCalculator";
import { GPU_ENTRIES } from "../../data/gpus";

const title = "Local LLM VRAM & Speed Calculator — Will It Fit, and How Fast?";
const description =
  "Calculate VRAM needed and estimated inference speed (tokens/sec) for Qwen3, Llama 3.1, Mistral, Gemma 4, Llama 4, and other models. Includes KV cache, hybrid attention, MoE, and Apple Silicon.";

const faqs = [
  {
    question: "Why does this calculator give different numbers than other VRAM calculators?",
    answer:
      "Most calculators only account for model weight size and ignore KV cache, which scales with context length. A model that fits comfortably at 2K context can run out of memory at 32K context purely from KV cache growth. This calculator separates both terms so you can see exactly where your VRAM is going.",
  },
  {
    question: "What's the difference between Q4_K_M and Q8_0?",
    answer:
      "Q4_K_M uses roughly 0.55 bytes per parameter with mixed-precision blocks, producing smaller files with a modest quality tradeoff. Q8_0 uses roughly 1 byte per parameter and is close to lossless compared to full FP16 precision. Q4_K_M is the practical default for most consumer GPUs; Q8_0 is worth it if you have VRAM to spare.",
  },
  {
    question: "Does KV cache quantization change these numbers?",
    answer:
      "This calculator assumes KV cache stored at FP16 (2 bytes per value), which is the common default in llama.cpp and Ollama. Some setups support quantized KV cache (e.g. Q8 or Q4 KV cache) to reduce this further, which would lower the KV cache portion of the estimate proportionally.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<BaseLayout title={title} description={description} path="/tools/vram-calculator/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <nav class="text-sm text-base-400 mb-6">
    <a href="/" class="hover:text-base-200">Home</a> /
    <a href="/tools/" class="hover:text-base-200">Tools</a> /
    <span class="text-base-200">VRAM Calculator</span>
  </nav>

  <h1 class="text-3xl font-bold text-base-50 mb-3">VRAM Calculator for Local LLMs</h1>
  <p class="text-base-400 mb-10 max-w-2xl">
    Estimate exact VRAM needed for model weights plus KV cache — the part most
    calculators skip, and the reason a model that loads fine at low context can
    still run out of memory once you ask it something long.
  </p>

  <div class="grid md:grid-cols-2 gap-8">
    <section class="bg-base-900 border border-base-700 rounded-xl p-6 space-y-5">
      <div>
        <label for="model-select" class="block text-sm font-medium text-base-200 mb-2">
          Model
        </label>
        <select
          id="model-select"
          class="w-full bg-base-800 border border-base-600 rounded-lg px-3 py-2 text-base-50 focus:outline-none focus:ring-2 focus:ring-accent-500"
        >
          {MODEL_ARCHITECTURES.map((model) => (
            <option value={model.id}>{model.label}</option>
          ))}
        </select>
      </div>

      <div id="custom-model-fields" class="hidden space-y-3 border-t border-base-700 pt-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="custom-params" class="block text-xs text-base-400 mb-1">Params (B)</label>
            <input
              id="custom-params"
              type="number"
              step="0.1"
              class="w-full bg-base-800 border border-base-600 rounded-lg px-3 py-2 text-base-50"
            />
          </div>
          <div>
            <label for="custom-layers" class="block text-xs text-base-400 mb-1">Layers</label>
            <input
              id="custom-layers"
              type="number"
              class="w-full bg-base-800 border border-base-600 rounded-lg px-3 py-2 text-base-50"
            />
          </div>
          <div>
            <label for="custom-kv-heads" class="block text-xs text-base-400 mb-1">KV heads</label>
            <input
              id="custom-kv-heads"
              type="number"
              class="w-full bg-base-800 border border-base-600 rounded-lg px-3 py-2 text-base-50"
            />
          </div>
          <div>
            <label for="custom-head-dim" class="block text-xs text-base-400 mb-1">Head dim</label>
            <input
              id="custom-head-dim"
              type="number"
              class="w-full bg-base-800 border border-base-600 rounded-lg px-3 py-2 text-base-50"
            />
          </div>
        </div>
        <p class="text-xs text-base-400">
          Find these in the model's <code class="text-accent-300">config.json</code> on Hugging Face
          (num_hidden_layers, num_key_value_heads, head_dim).
        </p>
      </div>

      <div>
        <label for="quant-select" class="block text-sm font-medium text-base-200 mb-2">
          Quantization
        </label>
        <select
          id="quant-select"
          class="w-full bg-base-800 border border-base-600 rounded-lg px-3 py-2 text-base-50 focus:outline-none focus:ring-2 focus:ring-accent-500"
        >
          {QUANT_FORMATS.map((quant) => (
            <option value={quant.id}>{quant.label} — {quant.description}</option>
          ))}
        </select>
      </div>

      <div>
        <label for="kv-preset-select" class="block text-sm font-medium text-base-200 mb-2">
          KV cache quantization
        </label>
        <select
          id="kv-preset-select"
          class="w-full bg-base-800 border border-base-600 rounded-lg px-3 py-2 text-base-50 focus:outline-none focus:ring-2 focus:ring-accent-500"
        >
          {KV_QUANT_PRESETS.map((preset) => (
            <option value={preset.id}>{preset.label} — {preset.description}</option>
          ))}
        </select>
        <p class="text-xs text-base-400 mt-1">
          K and V tensors have different compression sensitivity — V degrades quality
          faster than K at the same bit width. FP16/FP16 is the safe default.
        </p>
      </div>

      <div>
        <label for="context-length-select" class="block text-sm font-medium text-base-200 mb-2">
          Context length
        </label>
        <div class="flex gap-2">
          <select
            id="context-length-select"
            class="flex-1 bg-base-800 border border-base-600 rounded-lg px-3 py-2 text-base-50 focus:outline-none focus:ring-2 focus:ring-accent-500"
          >
            <option value="2048">2K (2,048)</option>
            <option value="4096">4K (4,096)</option>
            <option value="8192" selected>8K (8,192)</option>
            <option value="16384">16K (16,384)</option>
            <option value="32768">32K (32,768)</option>
            <option value="40960">40K (40,960)</option>
            <option value="65536">64K (65,536)</option>
            <option value="131072">128K (131,072)</option>
            <option value="262144">256K (262,144)</option>
            <option value="custom">Custom…</option>
          </select>
          <input
            id="context-length-custom"
            type="number"
            min="512"
            step="512"
            placeholder="tokens"
            class="hidden w-28 bg-base-800 border border-base-600 rounded-lg px-3 py-2 text-base-50 focus:outline-none focus:ring-2 focus:ring-accent-500"
          />
        </div>
        <p class="text-xs text-base-400 mt-1">
          For extended context via RoPE scaling, enter a custom value.
        </p>
      </div>

      <div>
        <label for="batch-size" class="block text-sm font-medium text-base-200 mb-2">
          Concurrent sequences
        </label>
        <input
          id="batch-size"
          type="number"
          min="1"
          value="1"
          class="w-full bg-base-800 border border-base-600 rounded-lg px-3 py-2 text-base-50"
        />
        <p class="text-xs text-base-400 mt-1">
          Leave at 1 for personal use (Ollama, LM Studio, llama.cpp). This is
          concurrent <em>sequences</em>, not llama.cpp's <code class="text-accent-300">-b</code> prompt-processing
          batch size — those are different things. Only increase if running a
          multi-user inference server where each user needs their own KV cache.
        </p>
      </div>

      <div>
        <label for="available-vram" class="block text-sm font-medium text-base-200 mb-2">
          Your GPU VRAM (GB)
        </label>
        <input
          id="available-vram"
          type="number"
          step="0.5"
          value="12"
          class="w-full bg-base-800 border border-base-600 rounded-lg px-3 py-2 text-base-50"
        />
      </div>

      <div>
        <label for="gpu-select" class="block text-sm font-medium text-base-200 mb-2">
          Your GPU <span class="text-base-400 font-normal text-xs">(for speed estimate)</span>
        </label>
        <select
          id="gpu-select"
          class="w-full bg-base-800 border border-base-600 rounded-lg px-3 py-2 text-base-50 focus:outline-none focus:ring-2 focus:ring-accent-500"
        >
          {(() => {
            const groups = [...new Set(GPU_ENTRIES.map((g) => g.group))];
            return groups.map((group) => (
              <optgroup label={group}>
                {GPU_ENTRIES.filter((g) => g.group === group).map((gpu) => (
                  <option value={gpu.id} selected={gpu.id === "rtx3060-12gb"}>
                    {gpu.label}
                  </option>
                ))}
              </optgroup>
            ));
          })()}
        </select>
        <div id="custom-bandwidth-field" class="hidden mt-2">
          <label for="custom-bandwidth" class="block text-xs text-base-400 mb-1">
            Memory bandwidth (GB/s)
          </label>
          <input
            id="custom-bandwidth"
            type="number"
            step="1"
            placeholder="e.g. 504"
            class="w-full bg-base-800 border border-base-600 rounded-lg px-3 py-2 text-base-50"
          />
          <p class="text-xs text-base-400 mt-1">
            Find your card's memory bandwidth on TechPowerUp GPU Database.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-base-900 border border-base-700 rounded-xl p-6">
      <h2 class="text-lg font-semibold text-base-50 mb-4">Estimated VRAM usage</h2>

      <div id="result-fit-banner" class="rounded-lg px-4 py-3 mb-5 font-medium"></div>

      <dl class="space-y-3 font-mono-display text-sm">
        <div class="flex justify-between border-b border-base-700 pb-2">
          <dt class="text-base-400">Model weights</dt>
          <dd id="result-weights" class="text-base-50">—</dd>
        </div>
        <div id="sliding-note" class="hidden border-b border-base-700 pb-2">
          <p class="text-xs text-accent-300 px-1">
            ℹ Sliding window hybrid model — KV cache has two components:
            <strong id="sliding-layers-count">—</strong> sliding-window layers
            (fixed, capped at <strong id="sliding-window-size">—</strong> tokens) +
            <strong id="global-layers-count">—</strong> global attention layers
            (grows with context length). The "max context" figure below reflects
            how much additional context the global layers can accommodate.
          </p>
        </div>
        <div id="hybrid-note" class="hidden border-b border-base-700 pb-2">
          <p class="text-xs text-accent-300 px-1">
            ℹ Hybrid attention model — KV cache calculated using
            <strong id="hybrid-full-layers">—</strong> full-attention layers
            (out of <strong id="hybrid-total-layers">—</strong> total).
            Linear/sliding-window layers don't accumulate a standard KV cache
            and are excluded from this estimate.
          </p>
        </div>
        <div id="moe-note" class="hidden border-b border-base-700 pb-2">
          <p class="text-xs text-signal-warn px-1">
            ⚠ MoE model — weight VRAM is based on <strong id="moe-total-params">—</strong> total parameters.
            All experts must be resident in memory even though only <strong id="moe-active-params">—</strong>
            are active per token. KV cache is shown separately below and reflects this model's
            actual attention architecture.
          </p>
        </div>
        <div class="flex justify-between border-b border-base-700 pb-2">
          <dt class="text-base-400">KV cache (total)</dt>
          <dd id="result-kv-cache" class="text-base-50">—</dd>
        </div>
        <div class="flex justify-between border-b border-base-700 pb-2 pl-4">
          <dt class="text-base-400 text-xs">↳ Keys</dt>
          <dd id="result-kv-keys" class="text-base-50 text-xs">—</dd>
        </div>
        <div class="flex justify-between border-b border-base-700 pb-2 pl-4">
          <dt class="text-base-400 text-xs">↳ Values</dt>
          <dd id="result-kv-values" class="text-base-50 text-xs">—</dd>
        </div>
        <div class="flex justify-between border-b border-base-700 pb-2">
          <dt class="text-base-400">Overhead (CUDA/framework)</dt>
          <dd id="result-overhead" class="text-base-50">—</dd>
        </div>
        <div class="flex justify-between pt-1 text-base font-semibold">
          <dt class="text-base-200">Total</dt>
          <dd id="result-total" class="text-accent-300">—</dd>
        </div>
      </dl>

      <div class="mt-6 pt-5 border-t border-base-700">
        <p class="text-sm text-base-400 mb-1">Max context that fits in VRAM (weights + KV only):</p>
        <p id="result-max-context" class="text-2xl font-mono-display text-base-50">—</p>
        <p class="text-xs text-base-400 mt-1 leading-relaxed">
          Upper bound — real compute buffers grow with context, so usable context is lower,
          and decode speed drops sharply approaching it.
        </p>
      </div>

      <div class="mt-6 pt-5 border-t border-base-700">
        <p class="text-sm text-base-400 mb-2">Estimated decode speed:</p>
        <p id="result-speed" class="text-2xl font-mono-display text-base-50">—</p>
        <p id="result-speed-tier" class="text-xs mt-1">—</p>
        <p id="result-speed-explanation" class="text-xs text-base-400 mt-2 leading-relaxed">—</p>
      </div>
    </section>

    <section class="bg-base-900 border border-base-700 rounded-xl p-6 md:col-span-2">
      <div class="flex items-start justify-between mb-4">
        <div>
          <h2 class="text-base font-semibold text-base-50">TurboQuant KV cache comparison</h2>
          <p class="text-xs text-base-400 mt-1">
            Theoretical estimates only — llama.cpp integration in progress, not yet in a stable release.
            Values assume both K and V compressed at the same bit target with no codebook overhead.
          </p>
        </div>
        <span class="text-xs border border-accent-500/40 text-accent-400 rounded px-2 py-0.5 ml-4 shrink-0">
          experimental
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm font-mono-display">
          <thead>
            <tr class="text-left text-xs text-base-400 border-b border-base-700">
              <th class="pb-2 font-normal">Method</th>
              <th class="pb-2 font-normal text-right">KV cache size</th>
              <th class="pb-2 font-normal text-right">vs F16/F16</th>
            </tr>
          </thead>
          <tbody id="turbo-quant-body">
            <tr>
              <td colspan="3" class="py-3 text-base-400 text-xs">
                Enter model parameters above to see estimates.
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-xs text-base-400 mt-4">
        <a
          href="https://arxiv.org/abs/2501.11032"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent-300 hover:text-accent-200 underline"
        >TurboQuant paper (ICLR 2026)</a>
        — K and V have different sensitivity to compression; real deployments may use
        asymmetric bit targets rather than the symmetric estimates shown here.
      </p>
    </section>
  </div>

  <section class="mt-14 space-y-6 max-w-3xl">
    <h2 class="text-2xl font-bold text-base-50">How this is calculated</h2>
    <p class="text-base-400">
      Total VRAM is the sum of three components, calculated separately rather than
      estimated as a single multiplier:
    </p>
    <div class="space-y-4">
      <div class="bg-base-900 border border-base-700 rounded-lg p-4">
        <h3 class="font-semibold text-base-50 mb-1">Model weights</h3>
        <p class="text-sm text-base-400">
          Parameter count × effective bytes-per-parameter for the chosen quantization.
          GGUF K-quants use mixed precision and block-wise scale factors, so this isn't
          a flat bit-count division — the values used here are calibrated against real
          GGUF file sizes.
        </p>
      </div>
      <div class="bg-base-900 border border-base-700 rounded-lg p-4">
        <h3 class="font-semibold text-base-50 mb-1">KV cache</h3>
        <p class="text-sm text-base-400">
          2 × layers × KV heads × head dimension × context length × 2 bytes × batch size.
          This is the term that grows with context length and is usually why a model
          that loads fine at short context runs out of memory on long conversations.
        </p>
      </div>
      <div class="bg-base-900 border border-base-700 rounded-lg p-4">
        <h3 class="font-semibold text-base-50 mb-1">Overhead</h3>
        <p class="text-sm text-base-400">
          A fixed ~0.6GB buffer for CUDA context initialization and inference framework
          overhead. Actual overhead varies slightly by backend (llama.cpp, vLLM, etc.).
        </p>
      </div>
    </div>
    <p class="text-sm text-base-400">
      Verified against a real Qwen3-14B Q8_0 load on an RTX 3060 12GB: predicted weight
      size alone (≈15.7GB) correctly exceeds 12GB, matching the observed out-of-memory
      result, while Q4_K_M (≈9.0GB) correctly fits, leaving modest headroom for context.
    </p>
  </section>

  <section class="mt-14 max-w-3xl">
    <div class="bg-base-900 border border-accent-500/30 rounded-xl p-5 flex items-start justify-between gap-4">
      <div>
        <h2 class="text-sm font-semibold text-base-50 mb-1">
          Getting a different number from another VRAM calculator?
        </h2>
        <p class="text-xs text-base-400">
          That's common — different tools use different methodology for quantization sizing
          and KV cache. Here's a breakdown of why the numbers diverge.
        </p>
      </div>
      <a
        href="/guides/vram-calculator-comparison/"
        class="shrink-0 text-xs border border-accent-500/40 text-accent-400 hover:bg-accent-500/10 rounded-lg px-3 py-2 transition-colors whitespace-nowrap"
      >
        Read the comparison →
      </a>
    </div>
  </section>

  <section class="mt-14 space-y-5 max-w-3xl">
    <h2 class="text-2xl font-bold text-base-50">FAQ</h2>
    {faqs.map((faq) => (
      <div>
        <h3 class="font-semibold text-base-200 mb-1">{faq.question}</h3>
        <p class="text-sm text-base-400">{faq.answer}</p>
      </div>
    ))}
  </section>

  <script>
    import { MODEL_ARCHITECTURES, getModelById, type ModelArchitecture } from "../../data/models";
    import { QUANT_FORMATS, getQuantById } from "../../data/quants";
    import { estimateVram, maxContextForVram, KV_QUANT_PRESETS, getKvPresetById, estimateTurboQuant } from "../../lib/vramCalculator";
    import { GPU_ENTRIES, getGpuById } from "../../data/gpus";
    import { estimateInferenceSpeed } from "../../lib/inferenceSpeed";

    const modelSelect = document.getElementById("model-select") as HTMLSelectElement;
    const kvPresetSelect = document.getElementById("kv-preset-select") as HTMLSelectElement;
    const gpuSelect = document.getElementById("gpu-select") as HTMLSelectElement;
    const customBandwidthField = document.getElementById("custom-bandwidth-field") as HTMLDivElement;
    const customBandwidthInput = document.getElementById("custom-bandwidth") as HTMLInputElement;
    const resultSpeed = document.getElementById("result-speed") as HTMLElement;
    const resultSpeedTier = document.getElementById("result-speed-tier") as HTMLElement;
    const resultSpeedExplanation = document.getElementById("result-speed-explanation") as HTMLElement;
    const customFields = document.getElementById("custom-model-fields") as HTMLDivElement;
    const customParams = document.getElementById("custom-params") as HTMLInputElement;
    const customLayers = document.getElementById("custom-layers") as HTMLInputElement;
    const customKvHeads = document.getElementById("custom-kv-heads") as HTMLInputElement;
    const customHeadDim = document.getElementById("custom-head-dim") as HTMLInputElement;
    const quantSelect = document.getElementById("quant-select") as HTMLSelectElement;
    const contextLengthSelect = document.getElementById("context-length-select") as HTMLSelectElement;
    const contextLengthCustom = document.getElementById("context-length-custom") as HTMLInputElement;
    const batchSizeInput = document.getElementById("batch-size") as HTMLInputElement;
    const availableVramInput = document.getElementById("available-vram") as HTMLInputElement;

    const resultWeights = document.getElementById("result-weights") as HTMLElement;
    const resultKvCache = document.getElementById("result-kv-cache") as HTMLElement;
    const resultKvKeys = document.getElementById("result-kv-keys") as HTMLElement;
    const resultKvValues = document.getElementById("result-kv-values") as HTMLElement;
    const resultOverhead = document.getElementById("result-overhead") as HTMLElement;
    const resultTotal = document.getElementById("result-total") as HTMLElement;
    const resultMaxContext = document.getElementById("result-max-context") as HTMLElement;
    const fitBanner = document.getElementById("result-fit-banner") as HTMLDivElement;
    const turboQuantBody = document.getElementById("turbo-quant-body") as HTMLTableSectionElement;

    function getCurrentModel(): ModelArchitecture {
      if (modelSelect.value === "custom") {
        return {
          id: "custom",
          label: "Custom",
          paramsBillion: Number(customParams.value) || 0,
          numLayers: Number(customLayers.value) || 0,
          numKvHeads: Number(customKvHeads.value) || 0,
          headDim: Number(customHeadDim.value) || 0,
          nativeContextLength: 8192,
        };
      }
      return getModelById(modelSelect.value);
    }

    function formatGB(value: number): string {
      return `${value.toFixed(2)} GB`;
    }

    function formatTokens(value: number): string {
      if (value <= 0) return "0 tokens";
      return `${value.toLocaleString()} tokens`;
    }

    function recalculate() {
      const model = getCurrentModel();
      const quant = getQuantById(quantSelect.value);
      const contextLength = contextLengthSelect.value === "custom"
        ? Number(contextLengthCustom.value) || 8192
        : Number(contextLengthSelect.value);
      const batchSize = Math.max(1, Number(batchSizeInput.value) || 1);
      const availableVram = Number(availableVramInput.value) || 0;

      if (model.paramsBillion <= 0 || model.numLayers <= 0) {
        // Custom model fields not yet filled in — show placeholder state, don't crash.
        resultWeights.textContent = "—";
        resultKvCache.textContent = "—";
        resultKvKeys.textContent = "—";
        resultKvValues.textContent = "—";
        resultOverhead.textContent = "—";
        resultTotal.textContent = "—";
        resultMaxContext.textContent = "—";
        turboQuantBody.innerHTML = `<tr><td colspan="3" class="py-3 text-base-400 text-xs">Enter model parameters above to see estimates.</td></tr>`;
        (document.getElementById("sliding-note") as HTMLDivElement).classList.add("hidden");
        (document.getElementById("hybrid-note") as HTMLDivElement).classList.add("hidden");
        (document.getElementById("moe-note") as HTMLDivElement).classList.add("hidden");
        resultSpeed.textContent = "—";
        resultSpeedTier.textContent = "—";
        resultSpeedExplanation.textContent = "—";
        fitBanner.textContent = "Enter custom model parameters to calculate.";
        fitBanner.className = "rounded-lg px-4 py-3 mb-5 font-medium bg-base-800 text-base-400";
        return;
      }

      const kvPreset = getKvPresetById(kvPresetSelect.value);
      const result = estimateVram({ model, quant, contextLength, batchSize, kvPreset });

      resultWeights.textContent = formatGB(result.weightsGB);

      // Hybrid attention note
      // Sliding window note
      const slidingNote = document.getElementById("sliding-note") as HTMLDivElement;
      const slidingLayersCount = document.getElementById("sliding-layers-count") as HTMLElement;
      const slidingWindowSize = document.getElementById("sliding-window-size") as HTMLElement;
      const globalLayersCount = document.getElementById("global-layers-count") as HTMLElement;
      if (model.slidingWindowConfig) {
        slidingNote.classList.remove("hidden");
        slidingLayersCount.textContent = String(model.slidingWindowConfig.slidingLayers);
        slidingWindowSize.textContent = model.slidingWindowConfig.slidingWindowSize.toLocaleString();
        globalLayersCount.textContent = String(model.slidingWindowConfig.globalLayers);
      } else {
        slidingNote.classList.add("hidden");
      }

      // Hybrid attention note
      const hybridNote = document.getElementById("hybrid-note") as HTMLDivElement;
      const hybridFullLayers = document.getElementById("hybrid-full-layers") as HTMLElement;
      const hybridTotalLayers = document.getElementById("hybrid-total-layers") as HTMLElement;
      if (model.numFullAttentionLayers !== undefined) {
        hybridNote.classList.remove("hidden");
        hybridFullLayers.textContent = String(model.numFullAttentionLayers);
        hybridTotalLayers.textContent = String(model.numLayers);
      } else {
        hybridNote.classList.add("hidden");
      }

      // MoE note — show when the selected model has distinct active vs total params
      const moeNote = document.getElementById("moe-note") as HTMLDivElement;
      const moeTotalParams = document.getElementById("moe-total-params") as HTMLElement;
      const moeActiveParams = document.getElementById("moe-active-params") as HTMLElement;
      if (model.isMoE && model.activeParamsBillion) {
        moeNote.classList.remove("hidden");
        moeTotalParams.textContent = `${model.paramsBillion}B`;
        moeActiveParams.textContent = `${model.activeParamsBillion}B`;
      } else {
        moeNote.classList.add("hidden");
      }
      resultKvCache.textContent = formatGB(result.kvCacheGB);
      resultKvKeys.textContent = formatGB(result.kvKeysGB);
      resultKvValues.textContent = formatGB(result.kvValuesGB);
      resultOverhead.textContent = formatGB(result.overheadGB);
      resultTotal.textContent = formatGB(result.totalGB);

      // TurboQuant comparison table — always uses F16/F16 baseline for the
      // savings column so the comparison is apples-to-apples regardless of
      // what KV preset the user has selected above.
      const turboEstimates = estimateTurboQuant(model, contextLength, batchSize);
      turboQuantBody.innerHTML = turboEstimates.map((est) => `
        <tr class="border-b border-base-800">
          <td class="py-2 text-base-200">TurboQuant ${est.label}</td>
          <td class="py-2 text-right text-base-50">${est.kvCacheGB.toFixed(3)} GB</td>
          <td class="py-2 text-right text-signal-good">−${est.savingsVsF16Pct}%</td>
        </tr>
      `).join("");

      // Inference speed estimate
      const gpu = getGpuById(gpuSelect.value);
      const customBandwidth = gpuSelect.value === "custom"
        ? Number(customBandwidthInput.value) || undefined
        : undefined;
      const speedResult = estimateInferenceSpeed({ gpu, model, quant, contextLength, kvPreset, customBandwidthGBs: customBandwidth });
      const speedDisplay = speedResult.tokensPerSecond >= 100
        ? `~${Math.round(speedResult.tokensPerSecond)} tok/s`
        : `~${speedResult.tokensPerSecond.toFixed(1)} tok/s`;
      resultSpeed.textContent = speedDisplay;
      const tierLabels = {
        fast: "✓ Fast — comfortable for interactive use",
        ok: "◎ Acceptable — interactive but not instant",
        slow: "⚠ Slow — usable, noticeable pauses",
        very_slow: "✗ Very slow — frustrating for chat",
      } as const;
      const tierColors = {
        fast: "text-signal-good",
        ok: "text-accent-300",
        slow: "text-signal-warn",
        very_slow: "text-signal-bad",
      } as const;
      const tier = speedResult.tier as keyof typeof tierLabels;
      resultSpeedTier.textContent = tierLabels[tier];
      resultSpeedTier.className = `text-xs mt-1 ${tierColors[tier]}`;
      resultSpeedExplanation.textContent = speedResult.explanation;

      const fits = result.totalGB <= availableVram;
      const maxContext = maxContextForVram(availableVram, model, quant, batchSize, kvPreset);
      resultMaxContext.textContent = formatTokens(maxContext);

      if (fits) {
        fitBanner.textContent = `✓ Fits comfortably in ${availableVram}GB VRAM`;
        fitBanner.className = "rounded-lg px-4 py-3 mb-5 font-medium bg-signal-good/10 text-signal-good border border-signal-good/30";
      } else {
        const overBy = result.totalGB - availableVram;
        fitBanner.textContent = `✗ Exceeds ${availableVram}GB VRAM by ${overBy.toFixed(2)}GB`;
        fitBanner.className = "rounded-lg px-4 py-3 mb-5 font-medium bg-signal-bad/10 text-signal-bad border border-signal-bad/30";
      }
    }

    modelSelect.addEventListener("change", () => {
      customFields.classList.toggle("hidden", modelSelect.value !== "custom");
      recalculate();
    });

    kvPresetSelect.addEventListener("change", recalculate);

    gpuSelect.addEventListener("change", () => {
      const isCustom = gpuSelect.value === "custom";
      customBandwidthField.classList.toggle("hidden", !isCustom);
      // Sync the VRAM input with the selected GPU's known VRAM when a real
      // GPU is picked — saves the user a manual update step. Custom entry
      // intentionally doesn't overwrite since the user needs to set it.
      if (!isCustom) {
        const gpu = getGpuById(gpuSelect.value);
        (document.getElementById("available-vram") as HTMLInputElement).value = String(gpu.vramGB);
      }
      recalculate();
    });

    customBandwidthInput.addEventListener("input", recalculate);

    contextLengthSelect.addEventListener("change", () => {
      const isCustom = contextLengthSelect.value === "custom";
      contextLengthCustom.classList.toggle("hidden", !isCustom);
      if (isCustom) contextLengthCustom.focus();
      recalculate();
    });

    [quantSelect, batchSizeInput, availableVramInput,
     customParams, customLayers, customKvHeads, customHeadDim,
     contextLengthCustom].forEach((el) => {
      el.addEventListener("input", recalculate);
    });

    recalculate();
  </script>
</BaseLayout>
