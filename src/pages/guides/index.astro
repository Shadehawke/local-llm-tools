---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Guides — llmfit";
const description = "In-depth explainers on local LLM hardware, quantization, and memory planning.";

interface Guide {
  slug: string;
  title: string;
  shortDescription: string;
}

const GUIDES: Guide[] = [
  {
    slug: "vram-calculator-comparison",
    title: "Why Different VRAM Calculators Give Different Numbers",
    shortDescription: "A methodology comparison — why the same model and quant can show different VRAM estimates across tools.",
  },
  {
    slug: "rtx-3060-local-llm",
    title: "RTX 3060 12GB for Local LLMs: What Fits, What Doesn't, and How Fast",
    shortDescription: "Exact VRAM requirements and estimated speeds for Llama 3.1, Qwen3, Phi-4, and more on a 3060 12GB.",
  },
  {
    slug: "rtx-4090-local-llm",
    title: "RTX 4090 24GB for Local LLMs: What Fits, and How Fast",
    shortDescription: "The 32B tier a 24GB card unlocks, what actually fits at each quant, and honest expectations for 70B.",
  },
  {
    slug: "rtx-4060-ti-16gb-local-llm",
    title: "RTX 4060 Ti 16GB for Local LLMs: What Fits, and How Fast",
    shortDescription: "The 16GB tier that fits a high-quant 14B or a 24B at Q4 — and the bandwidth tradeoff that makes it slower than a 3060.",
  },
];
---

<BaseLayout title={title} description={description} path="/guides/">
  <h1 class="text-3xl font-bold text-base-50 mb-8">Guides</h1>

  <div class="grid sm:grid-cols-2 gap-4">
    {GUIDES.map((guide) => (
      <a
        href={`/guides/${guide.slug}/`}
        class="block border border-base-700 bg-base-900 hover:border-accent-500 rounded-xl p-5 transition-colors"
      >
        <h2 class="font-semibold text-base-50 mb-2">{guide.title}</h2>
        <p class="text-sm text-base-400">{guide.shortDescription}</p>
      </a>
    ))}
  </div>
</BaseLayout>